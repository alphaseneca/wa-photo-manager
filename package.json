{
	"name": "whatsapp-photo-manager",
	"version": "1.1.0",
	"description": "WhatsApp Photo Manager - Professional photo management and download system for Whatsapp",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "ts-node src/index.ts",
		"dev": "ts-node src/index.ts",
		"test": "node scripts/test-runner.js",
		"package": "powershell -ExecutionPolicy Bypass -File scripts/build-package.ps1",
		"clean": "rimraf dist"
	},
	"keywords": [
		"whatsapp",
		"bot",
		"photo-manager",
		"download",
		"automation"
	],
	"author": "Ukesh Aryal",
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"dependencies": {
		"@open-wa/wa-automate": "4.76.0",
		"heic-convert": "^2.1.0",
		"puppeteer": "^24.0.0",
		"puppeteer-core": "^24.0.0",
		"sharp": "^0.35.4"
	},
	"devDependencies": {
		"@types/node": "^22.20.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.0",
		"rimraf": "^6.0.0"
	},
	"overrides": {
		"puppeteer": "$puppeteer",
		"puppeteer-core": "$puppeteer-core",
		"sharp": "$sharp",
		"postcss": "^8.5.28",
		"qs": "^6.16.0",
		"ws": "^8.21.3",
		"ip-address": "^10.7.2",
		"socket.io-parser": "^4.2.7",
		"http-cache-semantics": "^4.1.1",
		"semver": "^7.7.1",
		"sanitize-html": "^2.17.7",
		"send": "^0.19.0",
		"tmp": "^0.2.7"
	}
}
