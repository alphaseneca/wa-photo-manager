{
	"name": "whatsapp-photo-manager",
	"version": "1.0.0",
	"description": "WhatsApp Photo Manager - Professional photo management and download system for Whatsapp",
	"main": "dist/index.js",
	"bin": {
		"photo-manager": "dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"start": "ts-node src/index.ts",
		"dev": "ts-node src/index.ts",
		"clean": "rimraf dist",
		"pkg": "pkg . --targets node18-win-x64 --compress Brotli --output photo-manager.exe",
		"pkg:build": "npm run build && npm run pkg",
		"pkg:macos": "pkg . --targets node18-macos-x64,node18-macos-arm64 --compress Brotli --output photo-manager-macos",
		"pkg:linux": "pkg . --targets node18-linux-x64 --compress Brotli --output photo-manager-linux",
		"pkg:all": "npm run build && npm run pkg && npm run pkg:macos && npm run pkg:linux",
		"release:prepare:windows": "npm run build && npm run pkg && node scripts/prepare-windows-release.js",
		"release:prepare:unix": "npm run build && npm run pkg:macos && npm run pkg:linux",
		"release": "npm run pkg:all"
	},
	"keywords": [
		"whatsapp",
		"bot",
		"photo-manager",
		"download",
		"automation"
	],
	"author": "Ukesh Aryal",
	"license": "MIT",
	"engines": {
		"node": ">=14.0.0"
	},
	"dependencies": {
		"@open-wa/wa-automate": "^4.76.0",
		"heic-convert": "^2.1.0",
		"sharp": "^0.34.2"
	},
	"devDependencies": {
		"@types/node": "^18.7.6",
		"ts-node": "^10.9.1",
		"typescript": "^4.9.3",
		"rimraf": "^3.0.2",
		"pkg": "^5.8.1"
	},
	"pkg": {
		"assets": [
			"views/**/*",
			"public/**/*",
			".env"
		],
		"scripts": [
			"dist/**/*.js"
		],
		"targets": [
			"node18-win-x64"
		]
	}
}
